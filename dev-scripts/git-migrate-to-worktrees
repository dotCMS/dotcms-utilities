    # Output the path for easy copying or scripting
    echo "$DESTINATION_WORKTREE"
else
    # Script was sourced, we can change directory
    cd "$DESTINATION_WORKTREE"
    echo -e "${GREEN}✓ Changed directory to $CURRENT_BRANCH worktree${NC}"
fi